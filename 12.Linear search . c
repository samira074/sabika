#include <stdio.h>

int main()
{
    int a[100], n, i, search;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter number to search: ");
    scanf("%d", &search);

    for(i = 0; i < n; i++)
    {
        if(a[i] == search)
        {
            printf("Number found at index %d", i);
            return 0;
        }
    }

    printf("Number not found");

    return 0;
}

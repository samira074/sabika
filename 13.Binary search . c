#include <stdio.h>

int main()
{
    int a[100], n, i, search;
    int low, high, mid;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter sorted elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter number to search: ");
    scanf("%d", &search);

    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(a[mid] == search)
        {
            printf("Number found at index %d", mid);
            return 0;
        }
        else if(a[mid] < search)
            low = mid + 1;
        else
            high = mid - 1;
    }

    printf("Number not found");

    return 0;
}
